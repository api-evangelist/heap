          "name": "Identify a user",
          "request": {
            "name": "Identify a user",
            "description": {
              "content": "Migrates all events from an anonymous user_id to an identified user.\nOne identity is allowed per user_id; a maximum of 10 user_ids can be\nassociated with an identity in a rolling one-month window.\n",
              "type": "text/plain"
            },
