                    "description": "(Required) Heap signature header. Comma-separated key:value pairs containing a\ntimestamp (`ts`) and HMAC-SHA256 signature (`hmac`).\n",
                    "key": "Heap-Hash",
                    "value": "ts:150000000,hmac:XXXXXXXXX"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"id_token\": \"7a36ae58-c4b9-11eb-8529-0242ac130003\",\n  \"action_type\": \"segment.users.sync\",\n  \"customer_config\": {\n    \"fields\": [\n      {\n        \"field_id\": \"workspace\",\n        \"field_display_name\": \"Workspace\",\n        \"value\": {\n          \"id\": \"workspace_1\",\n          \"display_name\": \"Workspace 1\"\n        }\n      }\n    ]\n  },\n  \"data\": {\n    \"segment\": {\n      \"id\": 1338065,\n      \"name\": \"Free Customers\"\n    },\n    \"sync_info\": {\n      \"page_number\": 1,\n      \"total_pages\": 5,\n      \"sync_task_id\": \"afe74af0-496e-11ec-81d3-0242ac130003\"\n    },\n    \"add\": [\n      {\n        \"id\": \"user1@email.com\"\n      },\n      {\n        \"id\": \"user2@email.com\"\n      }\n    ]\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "",
              "cookie": [],
              "_postman_previewlanguage": "text"
