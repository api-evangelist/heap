{
  "item": [
    {
      "id": "522b3597-1f21-438c-8739-de0add298189",
      "name": "Webhooks",
      "description": {
        "content": "Partner-registered webhook endpoints invoked by Heap. The only\ndocumented action type is `segment.users.sync`, which delivers\ndelta adds/removes for a Heap behavioral segment.\n\nSignature verification:\n  1. Parse the `Heap-Hash` header (comma-separated key:value pairs).\n  2. Confirm the `ts` value is within the partner's tolerance window.\n  3. Concatenate `${ts}${requestbody}`.\n  4. Compute HMAC-SHA256 using the `webhook_secret_key` assigned at\n     webhook creation.\n  5. Constant-time compare against the `hmac` value from the header.\n\nReturn `200 OK` on success; `429` or other non-2xx responses trigger\nretries by Heap.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "18712899-4037-4095-93ad-fe62d91ec07e",
          "name": "segment.users.sync webhook receiver",
          "request": {
            "name": "segment.users.sync webhook receiver",
            "description": {
              "content": "Heap POSTs a delta sync payload to the partner's registered webhook\nURL whenever segment membership changes need to be propagated.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":partner_webhook_sync_url"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "partner_webhook_sync_url",
                  "description": "(Required) Partner-registered HTTPS path that receives segment syncs."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Heap signature header. Comma-separated key:value pairs containing a\ntimestamp (`ts`) and HMAC-SHA256 signature (`hmac`).\n",
                "key": "Heap-Hash",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"<uuid>\",\n  \"action_type\": \"<string>\",\n  \"customer_config\": {\n    \"fields\": [\n      {\n        \"field_id\": \"<string>\",\n        \"field_display_name\": \"<string>\",\n        \"field_type\": \"<string>\",\n        \"value\": {\n          \"id\": \"<string>\",\n          \"display_name\": \"<string>\"\n        }\n      },\n      {\n        \"field_id\": \"<string>\",\n        \"field_display_name\": \"<string>\",\n        \"field_type\": \"<string>\",\n        \"value\": {\n          \"id\": \"<string>\",\n          \"display_name\": \"<string>\"\n        }\n      }\n    ]\n  },\n  \"data\": {\n    \"segment\": {\n      \"id\": \"<long>\",\n      \"name\": \"<string>\"\n    },\n    \"sync_info\": {\n      \"page_number\": \"<long>\",\n      \"total_pages\": \"<long>\",\n      \"sync_task_id\": \"<uuid>\"\n    },\n    \"add\": [\n      {\n        \"id\": \"<string>\"\n      },\n      {\n        \"id\": \"<string>\"\n      }\n    ],\n    \"remove\": [\n      {\n        \"id\": \"<string>\"\n      },\n      {\n        \"id\": \"<string>\"\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "41887b18-ad56-4e12-8911-a95b1ce3930f",
              "name": "Sync acknowledged.",
